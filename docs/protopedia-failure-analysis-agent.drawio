        <mxCell id="title" value="誤答分析 Agent — 4段階のワークフロー" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;align=left;fontColor=#202124;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="620" height="36" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="内部のAgentを工程ごとにまとめ、コードで強制する境界と人間の判断を分離" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;align=left;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="31" y="48" width="680" height="24" as="geometry" /></mxCell>
        <mxCell id="legend" value="LLM　　ADK　　コード　　Backend / 保存" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;align=right;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="750" y="22" width="400" height="24" as="geometry" /></mxCell>

        <mxCell id="stage-1" value="&lt;b&gt;1　3視点で並列分析&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;ParallelAgent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#BDC1C6;strokeWidth=1.5;fontSize=15;verticalAlign=top;spacingTop=18;arcSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="270" height="450" as="geometry" /></mxCell>
        <mxCell id="input" value="&lt;b&gt;Backendから入力&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;教材・rubric・採点済み回答&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#9AA0A6;fontSize=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="198" width="230" height="52" as="geometry" /></mxCell>
        <mxCell id="misconception" value="&lt;b&gt;受講者のつまずき&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;misconception_analyst&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#A142F4;strokeWidth=1.4;fontSize=10;arcSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="278" width="230" height="58" as="geometry" /></mxCell>
        <mxCell id="doc-gap" value="&lt;b&gt;教材の説明不足&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;document_gap_analyst&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#A142F4;strokeWidth=1.4;fontSize=10;arcSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="354" width="230" height="58" as="geometry" /></mxCell>
        <mxCell id="question-quality" value="&lt;b&gt;設問・rubricの品質&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;question_quality_analyst&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#A142F4;strokeWidth=1.4;fontSize=10;arcSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="430" width="230" height="58" as="geometry" /></mxCell>

        <mxCell id="stage-2" value="&lt;b&gt;2　根拠をレビュー&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;LoopAgent・最大3回&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#BDC1C6;strokeWidth=1.5;fontSize=15;verticalAlign=top;spacingTop=18;arcSize=10;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="270" height="450" as="geometry" /></mxCell>
        <mxCell id="evidence-critic" value="&lt;b&gt;evidence critic&lt;/b&gt;&lt;br&gt;根拠を採用 / 棄却&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;accepted / rejected findings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#A142F4;strokeWidth=1.5;fontSize=10;arcSize=14;" vertex="1" parent="1"><mxGeometry x="345" y="225" width="220" height="92" as="geometry" /></mxCell>
        <mxCell id="critic-reviewer" value="&lt;b&gt;critic reviewer&lt;/b&gt;&lt;br&gt;判定を再確認&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;approvedFindingIds を明示&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#A142F4;strokeWidth=1.5;fontSize=10;arcSize=14;" vertex="1" parent="1"><mxGeometry x="345" y="350" width="220" height="92" as="geometry" /></mxCell>

        <mxCell id="stage-3" value="&lt;b&gt;3　検証して統合&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;code gate → LLM finalizer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#BDC1C6;strokeWidth=1.5;fontSize=15;verticalAlign=top;spacingTop=18;arcSize=10;" vertex="1" parent="1"><mxGeometry x="610" y="120" width="270" height="450" as="geometry" /></mxCell>
        <mxCell id="approved-gate" value="&lt;b&gt;ApprovedFindingsGate&lt;/b&gt;&lt;br&gt;承認IDを再検証&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;subset・重複・根拠をコード検証&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=1.8;fontColor=#137333;fontSize=10;arcSize=14;" vertex="1" parent="1"><mxGeometry x="635" y="225" width="220" height="92" as="geometry" /></mxCell>
        <mxCell id="finalizer" value="&lt;b&gt;finalizer&lt;/b&gt;&lt;br&gt;approved findings を入力に&lt;br&gt;FailureAnalysisOutput&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;意味対応はPromptで制約&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#A142F4;strokeWidth=1.5;fontSize=10;arcSize=14;" vertex="1" parent="1"><mxGeometry x="635" y="350" width="220" height="112" as="geometry" /></mxCell>

        <mxCell id="stage-4" value="&lt;b&gt;4　パッチ方針を決定&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;Backend保存 → 人間レビュー&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#BDC1C6;strokeWidth=1.5;fontSize=15;verticalAlign=top;spacingTop=18;arcSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="120" width="270" height="450" as="geometry" /></mxCell>
        <mxCell id="decision" value="&lt;b&gt;Failure Signal がある?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=1.7;fontColor=#137333;fontSize=11;arcSize=18;" vertex="1" parent="1"><mxGeometry x="925" y="198" width="220" height="50" as="geometry" /></mxCell>
